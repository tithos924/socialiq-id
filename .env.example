# =========================================================
# SocialIQ AI — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# =========================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose to the client/browser bundle.
SUPABASE_SECRET_KEY=

# --- Site URL (used for auth email redirect links) ---
NEXT_PUBLIC_SITE_URL=

# --- AI Provider ---
# Abstracted behind src/services/ai — swapping providers should not
# require touching application code.
AI_PROVIDER_KEY=

# --- Meta (Instagram / Facebook) ---
# Requires a Meta App with Instagram Graph API + Facebook Login products,
# app review for advanced permissions (instagram_basic, pages_show_list,
# instagram_manage_insights, etc).
META_CLIENT_ID=
META_CLIENT_SECRET=

# --- TikTok ---
# Requires a TikTok for Developers app with Content Posting API /
# Display API access, subject to TikTok app review.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- YouTube / Google ---
# Requires a Google Cloud project with YouTube Data API v3 enabled
# and an OAuth consent screen configured (verification needed for
# sensitive scopes in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LinkedIn ---
# Requires a LinkedIn app with Marketing Developer Platform access
# (partner approval required for most posting/analytics scopes).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Payments / Billing ---
# Wired through src/services/billing — provider-agnostic abstraction.
PAYMENT_PROVIDER_KEY=

# --- Monitoring & Analytics ---
SENTRY_DSN=
POSTHOG_KEY=
